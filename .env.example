# Required: use a unique random value with at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional initial administrator account (created if this email does not exist).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator
ADMIN_NICK=admin

# RabbitMQ credentials used by Docker Compose.
RABBITMQ_USER=booklibrary
RABBITMQ_PASS=replace-with-a-strong-rabbitmq-password

# Local development only: enables GraphQL Playground and introspection.
ENABLE_PLAYGROUND=false

# Set true only behind a reverse proxy you control.
TRUST_PROXY=false
